#!/bin/sh
set -eu

REAL_BWRAP=/opt/codex-sandbox/bwrap.real
# Never shown to a sandboxed command: the container environment s6 keeps (it holds the Supervisor
# token), Home Assistant's secrets and sign-in store, the app's own options and API token, and the
# app's GitHub sign-in (the worker does git for Codex through the github_git tool).
# Codex never needs them; `!secret` values resolve inside Home Assistant.

if [ "${1:-}" = "--version" ]; then
  exec "$REAL_BWRAP" "$@"
fi

is_codex_proc_probe() (
  # Use a subshell so probe bookkeeping cannot change the exec environment.
  # Codex's internal probe ends in exactly `-- /[usr/]bin/true`.
  # Real commands re-enter the Codex sandbox helper instead. Stop inspecting
  # arguments at the first separator so task payloads can never match.
  as_pid_1=0 user_ns=0 pid_ns=0 ipc_ns=0 proc_mount=0
  new_session=0 die_with_parent=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --as-pid-1) as_pid_1=1 ;;
      --new-session) new_session=1 ;;
      --die-with-parent) die_with_parent=1 ;;
      --unshare-user) user_ns=1 ;;
      --unshare-pid) pid_ns=1 ;;
      --unshare-ipc) ipc_ns=1 ;;
      --proc)
        [ "$#" -ge 2 ] && [ "$2" = /proc ] || return 1
        proc_mount=1
        shift
        ;;
      --)
        shift
        [ "$#" -eq 1 ] || return 1
        case "$1" in
          /bin/true|/usr/bin/true)
            [ "$as_pid_1$user_ns$pid_ns$ipc_ns$proc_mount$new_session$die_with_parent" = 1111111 ]
            return
            ;;
          *) return 1 ;;
        esac
        ;;
    esac
    shift
  done
  return 1
)

if is_codex_proc_probe "$@"; then
  exec /usr/bin/python3 /opt/codex-sandbox/codex-bwrap-probe.py "$@"
fi

# Read only the app's signed state, before entering the child sandbox. A failed
# reader retains all masks. No task-supplied environment value selects the file.
reader=/protection_switches.py
[ -f "$reader" ] || reader="$(dirname "$0")/protection_switches.py"
choices="$(/usr/bin/python3 -I "$reader" --sandbox-state 2>/dev/null)" || choices="1 1"
case "$choices" in
  "0 0") credentials_on=0; settings_on=0 ;;
  "0 1") credentials_on=0; settings_on=1 ;;
  "1 0") credentials_on=1; settings_on=0 ;;
  *) credentials_on=1; settings_on=1 ;;
esac
HIDDEN_DIRS="/run/s6 /data/remote_control_control /data/github"
HIDDEN_FILES="/config/secrets.yaml /config/.storage/auth /config/.storage/auth_provider.homeassistant /data/worker_api_token"
if [ "$credentials_on" = 0 ]; then
  HIDDEN_DIRS=""
  HIDDEN_FILES=""
fi
if [ "$settings_on" = 1 ]; then
  HIDDEN_DIRS="$HIDDEN_DIRS /data/protection-checks"
  HIDDEN_FILES="$HIDDEN_FILES /data/options.json /data/schedules.sqlite3 /data/schedules.sqlite3-journal /data/schedules.sqlite3-wal /data/schedules.sqlite3-shm"
fi

# Hide those paths in every real sandbox. The masks go just before the first `--`, after Codex's
# own binds, so a later bind of / or /config cannot uncover them. Only paths that exist are masked,
# so no empty file is ever created in their place.
masked=0
for arg do
  shift
  if [ "$masked" = 0 ] && [ "$arg" = "--" ]; then
    for hidden in $HIDDEN_DIRS; do
      if [ -d "$hidden" ]; then set -- "$@" --tmpfs "$hidden"; fi
    done
    for hidden in $HIDDEN_FILES; do
      if [ -f "$hidden" ]; then set -- "$@" --ro-bind /dev/null "$hidden"; fi
    done
    if [ "$settings_on" = 0 ]; then
      # The owner expressly permits writes to these existing app-internal paths.
      # No host mount, namespace or capability is added.
      for writable in /data/protection-checks /data/options.json /etc/codex /usr/share/ha_codex /data/codex-home/config.toml; do
        if [ -e "$writable" ]; then set -- "$@" --bind "$writable" "$writable"; fi
      done
    fi
    masked=1
  fi
  set -- "$@" "$arg"
done

exec "$REAL_BWRAP" --cap-drop ALL "$@"
